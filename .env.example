# MongoDB (REQUIRED, server-only: never prefix with NEXT_PUBLIC_)
# Local MongoDB:   mongodb://localhost:27017/tourmate
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tourmate?retryWrites=true&w=majority
# IMPORTANT: keep the database name (/tourmate) in the URI. Without it MongoDB uses the
# default "test" database and your app will look empty.
MONGODB_URI=mongodb://localhost:27017/tourmate

# Auth (REQUIRED, server-only). Required in production: the app refuses to sign or
# verify login tokens without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (image uploads) — optional. Without these, ImageUpload
# shows a graceful "not configured" state instead of failing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments) — optional. Without these, checkout runs in a
# clearly labeled Demo Payment Mode (no real order/charge).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps Embed API — optional. Without this, guide/destination
# pages show a plain location card instead of a map.
# NOTE: this key is exposed to the browser by design (Google's own
# guidance is to restrict it by HTTP referrer in Cloud Console, not
# hide it) — that's why it's prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Gemini (AI trip planner) — optional. Without this, the trip
# planner falls back to a local rule-based itinerary generator, and
# also falls back automatically if a live Gemini call ever fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
