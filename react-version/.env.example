# Where the dev server forwards /api/* requests (the Next.js backend).
# Default: the Next.js app running locally (npm run dev in the repo root).
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional: Google Maps Embed API key (same key as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY in the Next app).
VITE_GOOGLE_MAPS_API_KEY=
